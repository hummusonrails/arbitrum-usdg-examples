# sandbox: the Paxos sandbox and Arbitrum Sepolia
# production: the Paxos production API and Arbitrum One
# For local mode with no accounts, run `pnpm dev:mock` instead; it sets everything itself.
MODE=sandbox

# Paxos API credentials, created in the Paxos Dashboard
PAXOS_CLIENT_ID=
PAXOS_CLIENT_SECRET=
PAXOS_PROFILE_ID=
# Optional. Setup creates a sandbox bank account when this is empty.
PAXOS_BANK_ACCOUNT_ID=
# Your organization's identity and legal name, used to confirm deposits came from your own wallet
PAXOS_IDENTITY_ID=
PAXOS_INSTITUTION_NAME=
# 1 requests the extra scopes for deposit confirmation, wallet ownership proofs, and bank accounts
PAXOS_OPTIONAL_SCOPES=1

# The treasury wallet that holds USDG on Arbitrum (with or without the 0x prefix)
TREASURY_PRIVATE_KEY=
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Paxos sends this value in the x-api-key header of each webhook
WEBHOOK_API_KEY=

# Treasury band in USDG
POLICY_MIN=1000
POLICY_TARGET=5000
POLICY_MAX=10000
DEMO_WIRE_AMOUNT=2500.00

# How often the treasury loop runs, and where it keeps its records
LOOP_INTERVAL_MS=5000
DB_PATH=treasury.db
