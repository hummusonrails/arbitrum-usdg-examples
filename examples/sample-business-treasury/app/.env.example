# mock: local mock Paxos plus an Anvil fork of Arbitrum One
# sandbox: the Paxos sandbox plus Arbitrum Sepolia
MODE=mock

# Paxos API credentials (sandbox mode). Create them in the sandbox Dashboard.
PAXOS_CLIENT_ID=
PAXOS_CLIENT_SECRET=
PAXOS_PROFILE_ID=
PAXOS_BANK_ACCOUNT_ID=

# The treasury wallet that holds USDG on Arbitrum
TREASURY_PRIVATE_KEY=
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Paxos sends this value in the x-api-key header of each webhook
WEBHOOK_API_KEY=

# Treasury policy in USDG
POLICY_MIN=1000
POLICY_TARGET=5000
POLICY_MAX=10000
DEMO_WIRE_AMOUNT=2500
