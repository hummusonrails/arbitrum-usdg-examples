# mainnet: real Arbitrum One, real vaults, real Merkl rewards. At your own risk.
# For local mode with no accounts or funds, run `pnpm dev:fork` instead; it sets everything itself.
MODE=mainnet

# The omnibus wallet that holds every customer's vault shares (with or without the 0x prefix)
OMNIBUS_PRIVATE_KEY=
RPC_URL=https://arb1.arbitrum.io/rpc

# Live data sources for vault rates, incentives, and liquidity
MERKL_API_URL=https://api.merkl.xyz
MORPHO_API_URL=https://api.morpho.org
GMX_API_URL=https://arbitrum-api.gmxinfra.io

# How often the earn loop runs, and where it keeps its records
LOOP_INTERVAL_MS=5000
DB_PATH=earn.db
