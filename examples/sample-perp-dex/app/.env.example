# This example runs on a local fork only. `pnpm dev:fork` starts the fork,
# deploys the oracle and the margin vault, creates the payout group, and sets
# every value below for you. They are listed here so you can see what the app reads.

# Arbitrum One fork
RPC_URL=http://127.0.0.1:8545

# The Acme Perps operator: owns the vault and the oracle, and is the payout
# group's claimer, manager, and destination (with or without the 0x prefix)
OPERATOR_PRIVATE_KEY=

# The keeper: pushes prices, liquidates, and relays signed deposits
KEEPER_PRIVATE_KEY=

# Demo trader keys as JSON: {"ana":"0x...","kofi":"0x...","mei":"0x..."}
WALLET_KEYS=

# Deployed contracts and the payout group id
VAULT_ADDRESS=
ORACLE_ADDRESS=
PAYOUT_GROUP_ID=

# The block to read the vault's events from (defaults to the block at first boot)
START_BLOCK=

# How often the loop runs the keeper and reads the fork, and where it keeps its records
LOOP_INTERVAL_MS=3000
DB_PATH=perp.db

# Optional upstream RPC for the fork
# FORK_RPC_URL=https://arb1.arbitrum.io/rpc
