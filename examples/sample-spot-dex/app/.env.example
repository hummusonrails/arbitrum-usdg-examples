# This example runs on local forks only. `pnpm dev:fork` starts both forks,
# deploys and seeds the pools, creates the payout group, and sets every value
# below for you. They are listed here so you can see what the app reads.

# Arbitrum One fork and Ethereum fork
RPC_URL=http://127.0.0.1:8545
ETH_RPC_URL=http://127.0.0.1:8546

# The Acme Swap operator: owns the pools and is the payout group's claimer,
# manager, and destination (with or without the 0x prefix)
OPERATOR_PRIVATE_KEY=

# Demo wallet keys as JSON: {"lena":"0x...","omar":"0x...","priya":"0x..."}
WALLET_KEYS=

# Deployed pool addresses and the payout group id
POOL_WETH=
POOL_ARB=
PAYOUT_GROUP_ID=

# How often the loop reads both forks, and where it keeps its records
LOOP_INTERVAL_MS=3000
DB_PATH=dex.db

# Optional upstream RPCs for the forks
# FORK_RPC_URL=https://arb1.arbitrum.io/rpc
# ETH_FORK_RPC_URL=https://ethereum-rpc.publicnode.com
